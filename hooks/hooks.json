{
  "description": "Opt-in project-control guard for configured repositories.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'if [ -n \"$CLAUDE_PLUGIN_ROOT\" ]; then root=$CLAUDE_PLUGIN_ROOT; else root=$PLUGIN_ROOT; fi; exec /bin/sh \"$root/hooks/run-project-control.sh\" project-control-session-start'",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"$root = $env:CLAUDE_PLUGIN_ROOT; if (-not $root) { $root = $env:PLUGIN_ROOT }; & (Join-Path $root 'hooks/run-project-control.ps1') project-control-session-start; exit $LASTEXITCODE\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'if [ -n \"$CLAUDE_PLUGIN_ROOT\" ]; then root=$CLAUDE_PLUGIN_ROOT; else root=$PLUGIN_ROOT; fi; exec /bin/sh \"$root/hooks/run-project-control.sh\" project-control-stop'",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"$root = $env:CLAUDE_PLUGIN_ROOT; if (-not $root) { $root = $env:PLUGIN_ROOT }; & (Join-Path $root 'hooks/run-project-control.ps1') project-control-stop; exit $LASTEXITCODE\"",
            "timeout": 20,
            "statusMessage": "Checking project documentation impact"
          }
        ]
      }
    ]
  }
}
